{
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/packages/wrangler/config-schema.json",
  "name": "nunuza",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".open-next/assets",
  "queues": {
    "producers": [
      {
        "queue": "nunuza-agent-jobs",
        "binding": "AGENT_JOBS_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "nunuza-agent-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "nunuza-agent-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    // Non-secret runtime configuration only.
    // Secrets are supplied via `wrangler secret put` or Cloudflare dashboard.
    // See .env.example for all required variable names.
    "NEXT_PUBLIC_APP_ENV": "development"
  }
}
