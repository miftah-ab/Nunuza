# ─── Secrets — never commit real values ─────────────────────────────────────
# Copy this file to .env.local and fill in real values for local development.
# Production secrets are set via Cloudflare `wrangler secret put` or the dashboard.
# Never commit .env.local or any file with real secrets to source control.

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public URL and publishable anon key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Service role key — server-side only, never expose to browser or client bundle
# Used in server-side Queue consumers and admin operations only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── AI providers ─────────────────────────────────────────────────────────────
# Groq (primary provider)
GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# OpenRouter (fallback provider)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku

# ─── LinkedIn OAuth ───────────────────────────────────────────────────────────
# From the LinkedIn developer portal — keep secret, server-side only
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# Registered redirect URI (must match exactly what is registered in the developer portal)
LINKEDIN_REDIRECT_URI=http://localhost:3000/app/integrations/linkedin/callback

# Token encryption key — 32-byte random value, hex-encoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINKEDIN_TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# ─── Polar billing ────────────────────────────────────────────────────────────
# Use sandbox/test IDs only during development. Live IDs require all paid-launch gates.
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# Nunuza Solo product/price IDs in Polar (test mode only until live billing gates pass)
POLAR_PRODUCT_ID=your-polar-product-id
POLAR_PRICE_ID=your-polar-price-id

# ─── App configuration ────────────────────────────────────────────────────────
# Environment: development | preview | production
NEXT_PUBLIC_APP_ENV=development
# Public app URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cloudflare (wrangler supplies these at runtime — listed here for local dev) ─
# In production these are set via wrangler.jsonc vars or `wrangler secret put`
# AGENT_JOBS_QUEUE is available via the Cloudflare binding, not an env var
