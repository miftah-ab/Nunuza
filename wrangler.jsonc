{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nunuza",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "queues": {
    "producers": [
      {
        "queue": "nunuza-agent-jobs",
        "binding": "AGENT_JOBS_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "nunuza-agent-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "nunuza-agent-jobs-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_APP_ENV": "production"
  }
}
